# 이 파일을 복사해 server/.env 로 저장하고 키를 채워 넣으세요. (server/.env 는 git에 올라가지 않아요)
# 키를 비워 두면 그 출처는 샘플 데이터로 동작해요.

# 보조금24: 공공데이터포털 "행정안전부_대한민국 공공서비스(혜택) 정보" 활용신청 후 받은 일반 인증키(Decoding)
# https://www.data.go.kr/data/15113968/openapi.do
GOV24_SERVICE_KEY=

# 기업마당: 지원사업정보 API 사용신청 후 받은 인증키(crtfcKey)
# https://www.bizinfo.go.kr/apiDetail.do?id=bizinfoApi
BIZINFO_API_KEY=

# 서버 포트 (기본 8787)
# PORT=8787

# 허용할 앱 주소(쉼표로 구분). 비워 두면 모든 주소에서 호출할 수 있어요.
# ALLOWED_ORIGINS=
